NODE_ENV=production
PORT=4000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/rawaa

# أسرار JWT — ولّد قيمًا عشوائية طويلة ولا تستخدم هذه
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# دومين الفرونت إند بالضبط، بدون / في النهاية. عدة دومينات تُفصل بفاصلة
CORS_ORIGINS=https://rawaa.netlify.app,http://localhost:5173
COOKIE_DOMAIN=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rawaa

# حساب المدير الأول — يُستخدم مرة واحدة عند npm run seed
SEED_ADMIN_EMAIL=admin@rawaa.jo
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=مدير رواء

# ---------- QZ Tray (اختياري لكن مطلوب للطباعة الصامتة) ----------
# بدونهما تعمل الطباعة مع نافذة تأكيد في كل مرة على جهاز الكاشير.
# الشهادة عامة، والمفتاح الخاص سرّي ولا يوضع في الفرونت إند أبدًا.
# استبدل أسطر المفتاح بـ \n عند لصقه في Railway.
QZ_CERTIFICATE=
QZ_PRIVATE_KEY=
